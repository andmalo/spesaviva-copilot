# Chiave OpenAI (il valore vero va solo nel file .env, mai su GitHub)
OPENAI_API_KEY=inserisci-qui-la-tua-chiave

# Scenario simulato: "oggi" per l'agente, perché il dataset finisce il 2026-08-31
DATA_RIFERIMENTO=2026-09-01
NEGOZIO_UTENTE=NEG01

# Porte dei servizi (ChromaDB e FastAPI non devono usare la stessa porta)
BACKEND_PORT=3001
DATA_AGENT_PORT=8001
CHROMA_PORT=8000
OPENAI_MODEL=nome-del-modello

# Modello dell'orchestratore (separato da quello del data agent)
ORCHESTRATOR_MODEL=nome-del-modello
