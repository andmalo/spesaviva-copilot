# Chiave OpenAI (il valore vero va solo nel file .env, mai su GitHub)
OPENAI_API_KEY=inserisci-qui-la-tua-chiave

# La data di "oggi" e il negozio non si impostano qui: vengono dallo scenario della demo
# scelto nel front end (elenco in backend/scenari.json)

# Porte dei servizi (ChromaDB e FastAPI non devono usare la stessa porta)
BACKEND_PORT=3001
DATA_AGENT_PORT=8001
CHROMA_PORT=8000
OPENAI_MODEL=nome-del-modello
# Modello del solo data agent (facoltativo: se manca si usa OPENAI_MODEL)
DATA_AGENT_MODEL=

# Modello dell'orchestratore (separato da quello del data agent)
ORCHESTRATOR_MODEL=nome-del-modello

# Limiti dell'orchestratore (facoltativi: se mancano valgono i default indicati)
# Richieste massime al minuto su /api/chat
LIMITE_RICHIESTE_MINUTO=10
# Token massimi al giorno (orchestratore + data agent); superato il tetto l'assistente si ferma fino a domani
TETTO_TOKEN_GIORNALIERO=300000

# Log dei servizi (facoltativi)
# Livello: debug, info, warn, error (predefinito info). Al livello debug compaiono anche
# le prime 200 battute delle domande; mai la chiave, le risposte complete o il codice generato.
LOG_LEVEL=info
# Formato: leggibile (una riga di testo) oppure json. Vuoto: leggibile in locale, json in produzione (Docker)
LOG_FORMAT=

# Contatore dei token del giorno (facoltativo). Con REDIS_URL sta su Redis e sopravvive ai riavvii
# (su Render è il Key Value del render.yaml); senza, sta nel file backend/contatore_token.json.
REDIS_URL=

# Cache delle risposte della chat (facoltativi): voci massime in memoria e scadenza in minuti (al massimo 1440).
# Solo domande identiche all'inizio di una conversazione; una risposta dalla cache non consuma token.
CACHE_MAX_VOCI=200
CACHE_TTL_MINUTI=60

# Pulizia dei grafici del data agent (facoltativa): minuti tra due giri (predefinito 60).
# A ogni giro si cancellano i PNG più vecchi di 24 ore.
PULIZIA_GRAFICI_MINUTI=60
